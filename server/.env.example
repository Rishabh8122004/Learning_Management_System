# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Secret used to sign login tokens (required). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on (optional, defaults to 5000)
PORT=5000

# Password reset emails (optional: without these, "Forgot password?" cannot send mail).
# Create a free Brevo account, verify a sender address, then create an API key. Set these on the host only.
BREVO_API_KEY=
MAIL_FROM=
# Website address used in the reset link (optional: defaults to the first CLIENT_ORIGIN)
APP_URL=

# Browser origins allowed by CORS, comma-separated, no trailing slash
# (optional, defaults to http://localhost:5173). In production, set this to
# the real frontend URL; do not use a wildcard.
CLIENT_ORIGIN=http://localhost:5173
